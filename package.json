{
  "name": "careos",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx backend/server.ts",
    "start": "tsx backend/server.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "py": "node scripts/python.mjs",
    "db:validate": "node scripts/python.mjs database/validate.py",
    "db:migrate": "node scripts/python.mjs database/migrate.py",
    "analytics": "node scripts/python.mjs -m backend.analytics.cli serve",
    "analytics:check": "node scripts/python.mjs -m backend.analytics.cli check",
    "analytics:test": "node scripts/python.mjs -m unittest discover -s backend/analytics/tests -t .",
    "check": "bun run lint && bun run db:validate && bun run analytics:check && bun run analytics:test"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.6",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  }
}
