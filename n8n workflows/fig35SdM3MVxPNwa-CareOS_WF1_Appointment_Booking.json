    {
      "id": "da2fea8b-478a-412e-b4fa-0be326814606",
      "name": "Plan Booking",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1392,
        224
      ],
      "parameters": {
        "jsCode": "const s = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst raw = $('Normalize Request').first().json;\nconst req = raw;\nconst clean = (arr, k) => arr.map(i => i.json).filter(r => r && r[k]);\nconst patients = clean($('Get Patient').all(), 'patient_id');\nconst doctorsAll = clean($('Get Department Doctors').all(), 'doctor_id');\nconst appts = clean($('Get All Appointments').all(), 'appointment_id');\nconst queues = clean($('Get Department Queue').all(), 'department');\nconst nowIST = $now.setZone('Asia/Kolkata');\nconst todayIST = nowIST.toISODate();\nconst DAYS = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];\nconst toMin = (t) => { const m = /^(\\d{1,2}):(\\d{2})$/.exec(s(t)); return m ? parseInt(m[1],10)*60 + parseInt(m[2],10) : null; };\nconst fmt = (m) => String(Math.floor(m/60)).padStart(2,'0') + ':' + String(m%60).padStart(2,'0');\nconst weekday = (d) => { const dt = new Date(d + 'T00:00:00Z'); return DAYS[(dt.getUTCDay() + 6) % 7]; };\nconst addDays = (d, n) => { const dt = new Date(d + 'T00:00:00Z'); dt.setUTCDate(dt.getUTCDate() + n); return dt.toISOString().slice(0,10); };\n\nconst out = { req: req, status: 'error', reason: '', options: [], alternatives: [], write: false };\nconst fail = (status, reason, extra) => Object.assign(out, { status: status, reason: reason }, extra || {});\n\nconst eligibleDoctors = (date) => doctorsAll.filter(d => String(d.status).toLowerCase() === 'on_duty'\n  && (!req.doctor_id || d.doctor_id === req.doctor_id)\n  && String(d.available_days || '').split(',').map(x => x.trim()).indexOf(weekday(date)) !== -1);\nconst freeSlots = (date) => {\n  const res = [];\n  const nowMin = date === todayIST ? nowIST.hour * 60 + nowIST.minute : -1;\n  for (const d of eligibleDoctors(date)) {\n    const a = toMin(d.shift_start), b = toMin(d.shift_end), step = d.slot_minutes || 30;\n    if (a === null || b === null) continue;\n    const taken = appts.filter(x => x.doctor_id === d.doctor_id && x.appt_date === date && String(x.status).toLowerCase() !== 'cancelled').map(x => toMin(x.appt_time));\n    for (let m = a; m + step <= b; m += step) {\n      if (req.time_of_day === 'morning' && m >= 720) continue;\n      if (req.time_of_day === 'afternoon' && m < 720) continue;\n      if (m <= nowMin) continue;\n      if (taken.indexOf(m) !== -1) continue;\n      res.push({ doctor_id: d.doctor_id, doctor_name: d.doctor_name, department: d.department, date: date, time: fmt(m) });\n    }\n  }\n  return res.sort((x, y) => x.time.localeCompare(y.time) || x.doctor_id.localeCompare(y.doctor_id));\n};\nconst nextDates = (from) => {\n  const alts = [];\n  for (let i = 1; i <= 21 && alts.length < 2; i++) {\n    const d = addDays(from, i); const fs = freeSlots(d);\n    if (fs.length) alts.push({ date: d, slots: fs.slice(0, 3) });\n  }\n  return alts;\n};\n\n(function run() {\n  if (!req.patient_id) return fail('error', 'patient_id required');\n  if (!req.department && !req.doctor_id) return fail('error', 'department required');\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(req.appt_date)) return fail('error', 'appt_date must be YYYY-MM-DD');\n  if (req.appt_date < todayIST) return fail('error', 'appt_date is in the past');\n  if (['options','book'].indexOf(req.mode) === -1) return fail('error', \"mode must be 'options' or 'book'\");\n  if (req.time_of_day && ['morning','afternoon'].indexOf(req.time_of_day) === -1) return fail('error', \"time_of_day must be 'morning' or 'afternoon'\");\n  if (['patient','admin','operations','nurse','doctor','reception'].indexOf(req.user_role) === -1) return fail('forbidden', 'role ' + (req.user_role || '(none)') + ' may not book appointments');\n  if (req.user_role === 'patient' && req.user_ref.toUpperCase() !== req.patient_id) return fail('forbidden', 'patients may only book for their own patient_id');\n  const patient = patients[0];\n  if (!patient) return fail('error', 'patient ' + req.patient_id + ' not found');\n  out.patient = { patient_id: patient.patient_id, patient_name: patient.patient_name };\n  if (!doctorsAll.length) return fail('no_availability', 'no doctors found for department ' + req.department, { alternatives: [] });\n\n  const slots = freeSlots(req.appt_date);\n  if (req.mode === 'options') {\n    if (!slots.length) return fail('no_availability', 'no free slots on ' + req.appt_date, { alternatives: nextDates(req.appt_date) });\n    return Object.assign(out, { status: 'success', reason: 'options', options: slots.slice(0, 5) });\n  }\n  // book\n  if (!req.doctor_id || !req.preferred_time) return fail('error', 'doctor_id and preferred_time required to book');\n  const doc = doctorsAll.find(d => d.doctor_id === req.doctor_id);\n  if (!doc) return fail('error', 'doctor ' + req.doctor_id + ' not in department ' + req.department);\n  const pt = toMin(req.preferred_time);\n  if (pt === null) return fail('error', 'preferred_time must be HH:MM');\n  const t = fmt(pt);\n  const clash = appts.find(x => x.doctor_id === req.doctor_id && x.appt_date === req.appt_date && toMin(x.appt_time) === pt && String(x.status).toLowerCase() !== 'cancelled');\n  const patientClash = appts.find(x => x.patient_id === req.patient_id && x.appt_date === req.appt_date && toMin(x.appt_time) === pt && String(x.status).toLowerCase() !== 'cancelled');\n  if (clash || patientClash) {\n    return fail('conflict', clash ? ('slot ' + t + ' already taken by ' + clash.appointment_id) : ('patient already has ' + patientClash.appointment_id + ' at ' + t), { options: slots.slice(0, 5), alternatives: slots.length ? [] : nextDates(req.appt_date) });\n  }\n  if (!slots.find(x => x.doctor_id === req.doctor_id && x.time === t)) {\n    return fail('no_availability', doc.doctor_name + ' is not available at ' + t + ' on ' + req.appt_date, { options: slots.slice(0, 5), alternatives: slots.length ? [] : nextDates(req.appt_date) });\n  }\n  const maxNum = appts.reduce((m, x) => { const n = parseInt(String(x.appointment_id).replace(/\\D/g, ''), 10); return isNaN(n) ? m : Math.max(m, n); }, 5000);\n  const apptId = 'APT' + (maxNum + 1);\n  const q = queues.find(x => String(x.department).toLowerCase() === String(doc.department).toLowerCase());\n  let token = '';\n  let queueUpdate = null;\n  if (req.appt_date === todayIST && q) {\n    const next = (q.last_token_issued || 0) + 1;\n    token = (q.token_prefix || '') + next;\n    queueUpdate = { department: q.department, last_token_issued: next, patients_waiting: (q.patients_waiting || 0) + 1, updated_at: new Date().toISOString() };\n  }\n  const nowIso = new Date().toISOString();\n  const ts = Date.now();\n  Object.assign(out, {\n    status: 'success', reason: 'booked', write: true,\n    appointment: { appointment_id: apptId, patient_id: req.patient_id, doctor_id: doc.doctor_id, department: doc.department, appt_date: req.appt_date, appt_time: t, erp_appt_time: t, status: 'scheduled', queue_token: token, booked_by: 'appointment_agent', updated_at: nowIso },\n    doctor_name: doc.doctor_name,\n    needs_token: !!queueUpdate,\n    queue_update: queueUpdate || { department: '', last_token_issued: 0, patients_waiting: 0, updated_at: nowIso },\n    journey: { event_id: 'EVT-' + ts, patient_id: req.patient_id, event_type: 'APPOINTMENT_BOOKED', department: doc.department, actor: 'appointment_agent', status: 'completed', source_system: 'suvarna_erp', related_task: req.task_id, related_appointment: apptId, related_resource: doc.doctor_id, sequence: 0, event_time: nowIso },\n    notification: { notification_id: 'NTF-' + ts, created_at_ts: nowIso, recipient_type: 'patient', recipient_ref: req.patient_id, channel: 'in_app', message: 'Your appointment ' + apptId + ' with ' + doc.doctor_name + ' (' + doc.department + ') is confirmed for ' + req.appt_date + ' at ' + t + (token ? '. Queue token: ' + token : '') + '.', source_agent: 'appointment_agent', severity: 'info', status: 'sent' }\n  });\n})();\nreturn [{ json: out }];"
      }
    },
