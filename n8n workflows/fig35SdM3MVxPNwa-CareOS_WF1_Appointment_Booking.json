    {
      "id": "2e3cb4d8-61ca-4631-a344-d5355b6f1a3e",
      "name": "Build Audit Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        320
      ],
      "parameters": {
        "jsCode": "const p = $('Plan Booking').first().json;\nconst r = p.req;\nconst base = { log_time: new Date().toISOString(), task_id: r.task_id, user_role: r.user_role, user_ref: r.user_ref, request: r.request_text || ('book ' + r.department + ' ' + r.appt_date + ' ' + (r.preferred_time || r.time_of_day || '')), from_agent: r.from_agent, patient_id: r.patient_id };\nconst rows = [];\nif (p.write) {\n  rows.push(Object.assign({}, base, { to_agent: 'appointment_agent', action: 'create_appointment', system: 'suvarna_erp', result_status: 'success', result_summary: p.appointment.appointment_id + ' ' + p.doctor_name + ' ' + p.appointment.appt_date + ' ' + p.appointment.appt_time }));\n  if (p.needs_token) rows.push(Object.assign({}, base, { from_agent: 'appointment_agent', to_agent: 'queue_agent', action: 'issue_queue_token', system: 'careos_data_layer', result_status: 'success', result_summary: 'token ' + p.appointment.queue_token + ' for ' + p.appointment.appointment_id }));\n  rows.push(Object.assign({}, base, { from_agent: 'appointment_agent', to_agent: 'notification', action: 'send_notification', system: 'careos_data_layer', result_status: 'success', result_summary: 'in_app confirmation to ' + r.patient_id }));\n} else {\n  rows.push(Object.assign({}, base, { to_agent: 'appointment_agent', action: r.mode === 'book' ? 'create_appointment' : 'list_slot_options', system: 'suvarna_erp', result_status: p.status, result_summary: String(p.status === 'success' ? (p.options.length + ' slot options') : p.reason).slice(0, 480) }));\n}\nreturn rows.map(j => ({ json: j }));"
      },
      "executeOnce": true
    },
