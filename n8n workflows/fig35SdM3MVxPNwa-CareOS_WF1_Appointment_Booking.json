      ],
      "parameters": {
        "jsCode": "const p = $('Plan Booking').first().json;\nconst r = p.req;\nconst a = p.appointment || {};\nconst result = {\n  appointment_id: a.appointment_id || null,\n  patient_id: r.patient_id,\n  doctor_id: a.doctor_id || r.doctor_id || null,\n  doctor_name: p.doctor_name || null,\n  department: a.department || r.department,\n  appt_date: a.appt_date || r.appt_date,\n  appt_time: a.appt_time || null,\n  queue_token: a.queue_token || null,\n  options: p.options || []\n};\nif (p.status !== 'success' || p.reason !== 'booked') result.reason = p.reason;\nif (p.alternatives && p.alternatives.length) result.alternatives = p.alternatives;\nif (p.write) result.notification = p.notification.message;\nreturn [{ json: { task_id: r.task_id, agent: 'appointment_agent', status: p.status, result: result, _channel: r.channel } }];"
      },
      "executeOnce": true
    },
