    {
      "id": "b661fae1-a4e0-4455-b1c1-f79cf9a6374f",
      "name": "Build Audit Rows",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        320
      ],
      "parameters": {
        "jsCode": "const p = $('Plan Change').first().json;\nconst r = p.req;\nconst a = p.appt || {};\nconst base = { log_time: new Date().toISOString(), task_id: r.task_id, user_role: r.user_role, user_ref: r.user_ref, request: r.request_text || (r.action + ' ' + r.appointment_id + ' ' + r.new_date + ' ' + r.new_time).trim(), from_agent: r.from_agent, patient_id: a.patient_id || '' };\nconst actionName = r.action === 'cancel' ? 'cancel_appointment' : (r.action === 'reschedule' ? 'reschedule_appointment' : 'find_reschedule_slots');\nconst rows = [];\nif (p.write) {\n  rows.push(Object.assign({}, base, { to_agent: 'appointment_agent', action: actionName, system: 'suvarna_erp', result_status: 'success', result_summary: r.appointment_id + (p.reason === 'cancelled' ? ' cancelled (human confirmed)' : (' ' + a.appt_date + ' ' + a.appt_time + ' -> ' + p.new_date + ' ' + p.new_time)) }));\n  rows.push(Object.assign({}, base, { from_agent: 'appointment_agent', to_agent: 'notification', action: 'send_notification', system: 'careos_data_layer', result_status: 'success', result_summary: 'in_app notice to ' + a.patient_id }));\n} else {\n  rows.push(Object.assign({}, base, { to_agent: 'appointment_agent', action: actionName, system: 'suvarna_erp', result_status: p.status, result_summary: String(p.status === 'success' ? (p.options.length + ' slot options') : p.reason).slice(0, 480) }));\n}\nreturn rows.map(j => ({ json: j }));"
      },
      "executeOnce": true
    },
