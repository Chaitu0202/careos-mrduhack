    {
      "id": "f9cc2048-0fbf-4d32-9840-ad0011ec4166",
      "name": "Plan Change",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1168,
        224
      ],
      "parameters": {
        "jsCode": "const req = $('Normalize Request').first().json;\nconst s = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nconst clean = (arr, k) => arr.map(i => i.json).filter(r => r && r[k]);\nconst appt = clean($('Get Appointment').all(), 'appointment_id')[0];\nconst doc = clean($('Get Doctor').all(), 'doctor_id')[0];\nconst docAppts = clean($('Get Doctor Appointments').all(), 'appointment_id');\nconst nowIST = $now.setZone('Asia/Kolkata');\nconst todayIST = nowIST.toISODate();\nconst DAYS = ['Mon','Tue','Wed','Thu','Fri','Sat','Sun'];\nconst toMin = (t) => { const m = /^(\\d{1,2}):(\\d{2})$/.exec(s(t)); return m ? parseInt(m[1],10)*60 + parseInt(m[2],10) : null; };\nconst fmt = (m) => String(Math.floor(m/60)).padStart(2,'0') + ':' + String(m%60).padStart(2,'0');\nconst weekday = (d) => { const dt = new Date(d + 'T00:00:00Z'); return DAYS[(dt.getUTCDay() + 6) % 7]; };\nconst addDays = (d, n) => { const dt = new Date(d + 'T00:00:00Z'); dt.setUTCDate(dt.getUTCDate() + n); return dt.toISOString().slice(0,10); };\n\nconst out = { req: req, status: 'error', reason: '', options: [], write: false, appt: appt || null, doctor_name: doc ? doc.doctor_name : null };\nconst fail = (status, reason, extra) => Object.assign(out, { status: status, reason: reason }, extra || {});\n\nconst freeSlots = (date) => {\n  if (!doc || String(doc.status).toLowerCase() !== 'on_duty') return [];\n  if (String(doc.available_days || '').split(',').map(x => x.trim()).indexOf(weekday(date)) === -1) return [];\n  const a = toMin(doc.shift_start), b = toMin(doc.shift_end), step = doc.slot_minutes || 30;\n  if (a === null || b === null) return [];\n  const nowMin = date === todayIST ? nowIST.hour * 60 + nowIST.minute : -1;\n  const taken = docAppts.filter(x => x.appt_date === date && x.appointment_id !== appt.appointment_id && String(x.status).toLowerCase() !== 'cancelled').map(x => toMin(x.appt_time));\n  const res = [];\n  for (let m = a; m + step <= b; m += step) {\n    if (m <= nowMin || taken.indexOf(m) !== -1) continue;\n    res.push({ doctor_id: doc.doctor_id, doctor_name: doc.doctor_name, date: date, time: fmt(m) });\n  }\n  return res;\n};\nconst nextDays = (from, n) => {\n  const res = [];\n  for (let i = 0; i <= 21 && res.length < n; i++) {\n    const d = addDays(from, i); if (d < todayIST) continue;\n    const fs = freeSlots(d); if (fs.length) res.push({ date: d, slots: fs.slice(0, 4) });\n  }\n  return res;\n};\nconst flatten = (days) => days.reduce((acc, d) => acc.concat(d.slots), []);\n\n(function run() {\n  if (!req.appointment_id) return fail('error', 'appointment_id required');\n  if (['find_slots','reschedule','cancel'].indexOf(req.action) === -1) return fail('error', \"action must be find_slots, reschedule or cancel\");\n  if (['patient','admin','operations','nurse','doctor','reception'].indexOf(req.user_role) === -1) return fail('forbidden', 'role ' + (req.user_role || '(none)') + ' may not change appointments');\n  if (!appt) return fail('not_found', 'appointment ' + req.appointment_id + ' not found');\n  if (req.user_role === 'patient' && req.user_ref.toUpperCase() !== String(appt.patient_id).toUpperCase()) return fail('forbidden', 'patients may only change their own appointments');\n  const st = String(appt.status).toLowerCase();\n  if (st === 'cancelled' || st === 'completed') return fail('error', 'appointment ' + appt.appointment_id + ' is ' + st + ' and cannot be changed');\n  if (s(appt.erp_appt_time) && s(appt.appt_time) !== s(appt.erp_appt_time)) {\n    return fail('conflict_detected', 'Scheduling shows ' + appt.appt_time + ' while Suvarna ERP shows ' + appt.erp_appt_time + '. Human verification required.', { conflict: { scheduling_time: appt.appt_time, erp_time: appt.erp_appt_time } });\n  }\n  const nowIso = new Date().toISOString();\n  const ts = Date.now();\n  if (req.action === 'find_slots') {\n    const start = /^\\d{4}-\\d{2}-\\d{2}$/.test(req.new_date) ? req.new_date : addDays(todayIST, 1);\n    let opts = /^\\d{4}-\\d{2}-\\d{2}$/.test(req.new_date) ? freeSlots(req.new_date).slice(0, 8) : [];\n    if (!opts.length) opts = flatten(nextDays(start, 3));\n    if (!opts.length) return fail('no_availability', 'no free slots for ' + (doc ? doc.doctor_name : appt.doctor_id) + ' in the next 3 weeks');\n    return Object.assign(out, { status: 'success', reason: 'options', options: opts });\n  }\n  if (req.action === 'cancel') {\n    if (!req.confirmed) return fail('confirmation_required', 'Human confirmation required to cancel ' + appt.appointment_id);\n    return Object.assign(out, { status: 'success', reason: 'cancelled', write: true, new_date: appt.appt_date, new_time: appt.appt_time,\n      update: { appt_date: appt.appt_date, appt_time: appt.appt_time, erp_appt_time: appt.erp_appt_time || appt.appt_time, status: 'cancelled', updated_at: nowIso },\n      journey: { event_id: 'EVT-' + ts, patient_id: appt.patient_id, event_type: 'APPOINTMENT_CANCELLED', department: appt.department, actor: 'appointment_agent', status: 'completed', source_system: 'suvarna_erp', related_task: req.task_id, related_appointment: appt.appointment_id, related_resource: appt.doctor_id, sequence: 0, event_time: nowIso },\n      notification: { notification_id: 'NTF-' + ts, created_at_ts: nowIso, recipient_type: 'patient', recipient_ref: appt.patient_id, channel: 'in_app', message: 'Your appointment ' + appt.appointment_id + ' on ' + appt.appt_date + ' at ' + appt.appt_time + ' has been cancelled.', source_agent: 'appointment_agent', severity: 'info', status: 'sent' } });\n  }\n  // reschedule\n  if (!/^\\d{4}-\\d{2}-\\d{2}$/.test(req.new_date)) return fail('error', 'new_date must be YYYY-MM-DD');\n  if (req.new_date < todayIST) return fail('error', 'new_date is in the past');\n  const nt = toMin(req.new_time);\n  if (nt === null) return fail('error', 'new_time must be HH:MM');\n  const t = fmt(nt);\n  if (req.new_date === appt.appt_date && t === fmt(toMin(appt.appt_time))) return fail('error', 'new slot is the same as the current slot');\n  const free = freeSlots(req.new_date);\n  if (!free.find(x => x.time === t)) {\n    const clash = docAppts.find(x => x.appt_date === req.new_date && toMin(x.appt_time) === nt && x.appointment_id !== appt.appointment_id && String(x.status).toLowerCase() !== 'cancelled');\n    const alts = free.length ? free.slice(0, 5) : flatten(nextDays(addDays(req.new_date, 1), 3));\n    return fail('slot_taken', clash ? ('slot ' + t + ' on ' + req.new_date + ' is taken by ' + clash.appointment_id) : ((doc ? doc.doctor_name : appt.doctor_id) + ' is not available at ' + t + ' on ' + req.new_date), { options: alts });\n  }\n  return Object.assign(out, { status: 'success', reason: 'rescheduled', write: true, new_date: req.new_date, new_time: t,\n    update: { appt_date: req.new_date, appt_time: t, erp_appt_time: t, status: 'rescheduled', updated_at: nowIso },\n    journey: { event_id: 'EVT-' + ts, patient_id: appt.patient_id, event_type: 'APPOINTMENT_RESCHEDULED', department: appt.department, actor: 'appointment_agent', status: 'completed', source_system: 'suvarna_erp', related_task: req.task_id, related_appointment: appt.appointment_id, related_resource: appt.doctor_id, sequence: 0, event_time: nowIso },\n    notification: { notification_id: 'NTF-' + ts, created_at_ts: nowIso, recipient_type: 'patient', recipient_ref: appt.patient_id, channel: 'in_app', message: 'Your appointment ' + appt.appointment_id + ' with ' + (doc ? doc.doctor_name : appt.doctor_id) + ' moved from ' + appt.appt_date + ' ' + appt.appt_time + ' to ' + req.new_date + ' ' + t + '.', source_agent: 'appointment_agent', severity: 'info', status: 'sent' } });\n})();\nreturn [{ json: out }];"
      }
    },
