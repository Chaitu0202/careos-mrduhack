      "parameters": {
        "jsCode": "const p = $('Plan Change').first().json;\nconst r = p.req;\nconst a = p.appt || {};\nconst result = {\n  appointment_id: r.appointment_id,\n  patient_id: a.patient_id || null,\n  doctor_id: a.doctor_id || null,\n  doctor_name: p.doctor_name || null,\n  old_date: a.appt_date || null,\n  old_time: a.appt_time || null,\n  new_date: p.new_date || null,\n  new_time: p.new_time || null,\n  options: p.options || []\n};\nif (p.status !== 'success' || p.reason === 'options') result.message = p.reason;\nif (p.conflict) result.conflict = p.conflict;\nif (p.write) { result.appointment_status = p.update.status; result.notification = p.notification.message; }\nreturn [{ json: { task_id: r.task_id, agent: 'appointment_agent', status: p.status, result: result, _channel: r.channel } }];"
      },
      "executeOnce": true
    },
