      "parameters": {
        "jsCode": "const raw = $input.first().json || {};\nconst isWebhook = !!(raw.body && typeof raw.body === 'object' && raw.headers);\nconst src = isWebhook ? raw.body : raw;\nconst s = (v) => (v === undefined || v === null) ? '' : String(v).trim();\nreturn [{ json: {\n  channel: isWebhook ? 'webhook' : 'tool',\n  task_id: s(src.task_id) || ('TASK-' + Date.now()),\n  from_agent: s(src.from_agent) || 'orchestrator',\n  appointment_id: s(src.appointment_id).toUpperCase(),\n  action: s(src.action).toLowerCase(),\n  new_date: s(src.new_date),\n  new_time: s(src.new_time),\n  confirmed: src.confirmed === true || s(src.confirmed).toLowerCase() === 'true',\n  user_role: s(src.user_role).toLowerCase(),\n  user_ref: s(src.user_ref),\n  request_text: s(src.request_text)\n} }];"
      }
